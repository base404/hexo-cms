{
  "name": "hexo-cms",
  "version": "1.0.0",
  "description": "Zero-CLI Web CMS for Hexo Static Blogs (Geist / Vercel Design System)",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx watch server/src/index.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "vite build",
    "build:sea": "node build-sea.js",
    "build:all": "node build-all.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^2.4.0",
    "@tiptap/pm": "^2.4.0",
    "@tiptap/react": "^2.4.0",
    "@tiptap/starter-kit": "^2.4.0",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.9.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.395.0",
    "marked": "^12.0.2",
    "mermaid": "^10.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.25.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "execa": "^8.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
